<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <TextureView android:id="@+id/pVideo"
        android:layout_width="match_parent" android:layout_height="match_parent"/>

    <TextView android:id="@+id/pCenterIcon"
        android:layout_width="76dp" android:layout_height="76dp"
        android:layout_gravity="center" android:background="@drawable/bg_pill"
        android:gravity="center" android:text="⏸" android:textColor="#FFFFFF"
        android:textSize="30sp" android:visibility="gone"/>

    <TextView android:id="@+id/pHint"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:background="@drawable/bg_pill"
        android:paddingLeft="18dp" android:paddingRight="18dp"
        android:paddingTop="10dp" android:paddingBottom="10dp"
        android:textColor="#FFFFFF" android:textSize="14sp"
        android:visibility="gone"/>

    <LinearLayout android:id="@+id/pTopBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:background="@drawable/bg_bar"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="6dp" android:paddingRight="14dp"
        android:paddingTop="8dp" android:paddingBottom="22dp">
        <TextView android:id="@+id/pBack"
            android:layout_width="42dp" android:layout_height="42dp"
            android:gravity="center" android:text="‹" android:textColor="#FFFFFF"
            android:textSize="30sp"/>
        <TextView android:id="@+id/pTitle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:singleLine="true"
            android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/pBottomBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:background="@drawable/bg_bar"
        android:orientation="vertical" android:paddingLeft="14dp"
        android:paddingRight="14dp" android:paddingTop="30dp"
        android:paddingBottom="10dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/pTimeNow"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="00:00" android:textColor="#FFFFFF" android:textSize="12sp"/>
            <SeekBar android:id="@+id/pSeek"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp" android:max="1000"
                android:progressDrawable="@drawable/seek_progress"
                android:thumb="@drawable/seek_thumb"
                android:splitTrack="false"/>
            <TextView android:id="@+id/pTimeAll"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="00:00" android:textColor="#B0B0BC" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="4dp">
            <TextView android:id="@+id/pPlayPause"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:padding="10dp" android:text="⏸" android:textColor="#FFFFFF"
                android:textSize="20sp"/>
            <TextView android:id="@+id/pSpeed"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:padding="10dp" android:text="1.0X" android:textColor="#FFFFFF"
                android:textSize="13sp" android:textStyle="bold"/>
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1"/>
            <TextView android:id="@+id/pDownload"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:padding="10dp" android:text="⇩ 下载" android:textColor="#FFFFFF"
                android:textSize="13sp"/>
            <TextView android:id="@+id/pFull"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:padding="10dp" android:text="⛶" android:textColor="#FFFFFF"
                android:textSize="18sp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
