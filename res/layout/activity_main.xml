<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:id="@+id/root"
    android:orientation="vertical" android:background="@color/bg">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingLeft="20dp" android:paddingRight="12dp"
        android:paddingTop="18dp" android:paddingBottom="12dp">

        <View
            android:layout_width="4dp" android:layout_height="24dp"
            android:background="@drawable/brand_bar"/>

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:id="@+id/tvTitleDY" android:text="解析器" android:textColor="@color/text"
            android:textStyle="bold" android:textSize="22sp" android:letterSpacing="0.01"/>
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:id="@+id/tvTitle" android:text="Pro" android:textColor="@color/brand"
            android:textStyle="bold" android:textSize="13sp"
            android:background="@drawable/pill_brand"
            android:paddingLeft="7dp" android:paddingRight="7dp"
            android:paddingTop="2dp" android:paddingBottom="2dp"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <TextView android:id="@+id/btnTheme"
            android:layout_width="38dp" android:layout_height="38dp"
            android:background="@drawable/btn_icon" android:gravity="center"
            android:text="暗" android:textColor="@color/text_sub" android:textSize="14sp"/>
    </LinearLayout>

    <!-- 四页签：解析 / 列表 / 历史 / 设置 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="18dp" android:paddingRight="18dp"
        android:paddingBottom="8dp">

        <TextView android:id="@+id/tabParse"
            android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:background="@drawable/tab_active" android:gravity="center"
            android:text="解析" android:textColor="@color/text" android:textSize="13sp"
            android:textStyle="bold"/>
        <TextView android:id="@+id/tabList"
            android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:layout_marginLeft="6dp" android:background="@drawable/tab_idle" android:gravity="center"
            android:text="列表" android:textColor="@color/text_hint" android:textSize="13sp"/>
        <TextView android:id="@+id/tabHistory"
            android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:layout_marginLeft="6dp" android:background="@drawable/tab_idle" android:gravity="center"
            android:text="历史" android:textColor="@color/text_hint" android:textSize="13sp"/>
        <TextView android:id="@+id/tabSettings"
            android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:layout_marginLeft="6dp" android:background="@drawable/tab_idle" android:gravity="center"
            android:text="设置" android:textColor="@color/text_hint" android:textSize="13sp"/>
    </LinearLayout>

    <!-- 页签 1：解析页 -->
    <LinearLayout android:id="@+id/pageParse"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp" android:paddingRight="18dp">

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="支持 抖音 · 快手 · TikTok · X · YouTube"
                android:textColor="@color/text_hint" android:textSize="11sp"
                android:paddingLeft="4dp" android:paddingBottom="8dp"/>

            <TextView android:id="@+id/tvSrvInfo"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="内置服务器有效期至 2027-04-20"
                android:textColor="@color/text_hint" android:textSize="10sp"
                android:paddingLeft="4dp" android:paddingBottom="8dp"/>

            <EditText android:id="@+id/input"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:background="@drawable/input_bg" android:paddingLeft="16dp"
                android:paddingRight="16dp" android:hint="粘贴分享链接或口令"
                android:textColor="@color/text" android:textColorHint="@color/text_hint"
                android:textSize="14sp" android:singleLine="true" android:inputType="textUri"/>

            <TextView android:id="@+id/btn"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="12dp" android:background="@drawable/btn_primary"
                android:gravity="center" android:text="解 析" android:textColor="#FFFFFF"
                android:textStyle="bold" android:textSize="16sp" android:letterSpacing="0.08"/>

            <TextView android:id="@+id/status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="就绪" android:textColor="@color/text_sub" android:textSize="12sp"
                android:paddingTop="10dp" android:paddingBottom="6dp"
                android:paddingLeft="4dp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/progressBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone"
            android:background="@drawable/card_progress"
            android:layout_marginLeft="18dp" android:layout_marginRight="18dp"
            android:layout_marginTop="2dp" android:layout_marginBottom="8dp"
            android:paddingLeft="14dp" android:paddingRight="14dp"
            android:paddingTop="11dp" android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">

                <TextView android:id="@+id/progressLabel"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="准备中"
                    android:textColor="@color/text_sub" android:textSize="12sp"/>

                <TextView android:id="@+id/progressPct"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0%" android:textColor="@color/brand"
                    android:textSize="12sp" android:textStyle="bold"/>
            </LinearLayout>

            <ProgressBar android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp"
                android:layout_marginTop="8dp" android:max="1000"
                android:progress="0" android:progressDrawable="@drawable/progress_h"
                android:progressTint="@color/brand"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/actions"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:visibility="gone"
            android:paddingLeft="18dp" android:paddingRight="18dp"
            android:paddingBottom="10dp">

            <TextView android:id="@+id/btnPlay"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:background="@drawable/btn_ghost" android:gravity="center"
                android:text="播放" android:textColor="@color/text" android:textSize="13sp"/>
            <TextView android:id="@+id/btnDl"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:layout_marginLeft="7dp" android:background="@drawable/btn_ghost"
                android:gravity="center" android:text="下载" android:textColor="@color/text"
                android:textSize="13sp"/>
            <TextView android:id="@+id/btnFull"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:layout_marginLeft="7dp" android:background="@drawable/btn_primary"
                android:gravity="center" android:text="全屏" android:textColor="#FFFFFF"
                android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:id="@+id/btnAudio"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:layout_marginLeft="7dp" android:background="@drawable/btn_ghost"
                android:gravity="center" android:text="转MP3" android:textColor="@color/text"
                android:textSize="13sp"/>
            <TextView android:id="@+id/btnMusic"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:layout_marginLeft="7dp" android:background="@drawable/btn_ghost"
                android:gravity="center" android:text="BGM" android:textColor="@color/text"
                android:textSize="13sp" android:visibility="gone"/>
        </LinearLayout>

        <ScrollView android:id="@+id/scrollOut"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="18dp" android:paddingRight="18dp"
                android:paddingTop="10dp" android:paddingBottom="18dp">

                <FrameLayout android:id="@+id/videoBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/card_player" android:visibility="gone">

                    <TextureView android:id="@+id/video"
                        android:layout_width="match_parent" android:layout_height="210dp"/>

                    <LinearLayout android:id="@+id/miniBar"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_gravity="bottom" android:background="@drawable/bg_bar"
                        android:orientation="vertical" android:paddingLeft="12dp"
                        android:paddingRight="12dp" android:paddingTop="16dp"
                        android:paddingBottom="8dp">

                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:id="@+id/miniTimeNow"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="00:00" android:textColor="@color/white" android:textSize="10sp"/>
                            <SeekBar android:id="@+id/miniSeek"
                                android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:layout_marginLeft="8dp"
                                android:layout_marginRight="8dp" android:max="1000"
                                android:progressDrawable="@drawable/seek_progress"
                                android:thumb="@drawable/seek_thumb" android:splitTrack="false"/>
                            <TextView android:id="@+id/miniTimeAll"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="00:00" android:textColor="@color/white_sub" android:textSize="10sp"/>
                        </LinearLayout>

                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical">
                            <TextView android:id="@+id/miniPlay"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:padding="6dp" android:text="||" android:textColor="@color/white"
                                android:textSize="16sp" android:textStyle="bold"/>
                            <TextView android:id="@+id/miniSpeed"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:padding="6dp" android:text="1.0X" android:textColor="@color/white"
                                android:textSize="11sp" android:textStyle="bold"/>
                            <View android:layout_width="0dp" android:layout_height="1dp"
                                android:layout_weight="1"/>
                            <TextView android:id="@+id/miniFull"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:padding="6dp" android:text="全屏" android:textColor="@color/white"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <ImageView android:id="@+id/img"
                        android:layout_width="match_parent" android:layout_height="280dp"
                        android:background="@color/surface_alt" android:scaleType="fitCenter"
                        android:visibility="gone"/>

                    <TextView android:id="@+id/liveBadge"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="top|start" android:layout_margin="10dp"
                        android:background="#B3000000" android:paddingLeft="9dp" android:paddingRight="9dp"
                        android:paddingTop="3dp" android:paddingBottom="3dp"
                        android:textColor="#FFFFFF" android:text="LIVE" android:textSize="11sp"
                        android:textStyle="bold" android:visibility="gone"/>
                </FrameLayout>

                <LinearLayout android:id="@+id/out"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 页签 2：列表页（主页列表 / 播放列表，可逐条下载） -->
    <LinearLayout android:id="@+id/pageList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:visibility="gone">

        <TextView android:id="@+id/listHead"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="粘贴主页链接后点解析，列表会出现在这里"
            android:textColor="@color/text_hint" android:textSize="12sp"
            android:paddingLeft="18dp" android:paddingRight="18dp"
            android:paddingTop="6dp" android:paddingBottom="6dp"/>

        <TextView android:id="@+id/btnDlAll"
            android:layout_width="match_parent" android:layout_height="40dp"
            android:layout_marginLeft="18dp" android:layout_marginRight="18dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_primary" android:gravity="center"
            android:text="全部下载" android:textColor="#FFFFFF"
            android:textSize="13sp" android:textStyle="bold" android:visibility="gone"/>

        <ScrollView android:id="@+id/listScroll"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout android:id="@+id/listWrap"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="18dp" android:paddingRight="18dp"
                android:paddingBottom="18dp"/>
        </ScrollView>
    </LinearLayout>

    <!-- 页签 3：历史页 -->
    <ScrollView android:id="@+id/pageHistory"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:visibility="gone"
        android:scrollbars="none" android:overScrollMode="never">

        <LinearLayout android:id="@+id/historyWrap"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp" android:paddingRight="18dp"
            android:paddingTop="10dp" android:paddingBottom="18dp">

            <TextView android:id="@+id/historyEmpty"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:paddingTop="40dp"
                android:text="暂无历史记录\n\n下载过的文件、解析过的列表\n都会出现在这里"
                android:textColor="@color/text_hint" android:textSize="13sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- 页签 4：设置页 -->
    <ScrollView android:id="@+id/pageSettings"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:visibility="gone"
        android:scrollbars="none" android:overScrollMode="never">

        <LinearLayout android:id="@+id/settingsWrap"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp" android:paddingRight="18dp"
            android:paddingTop="10dp" android:paddingBottom="18dp"/>
    </ScrollView>

    <WebView android:id="@+id/web"
        android:layout_width="1dp" android:layout_height="1dp"/>
</LinearLayout>